{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["node"], "composite": true, "noEmit": true,
    "baseUrl": ".", "paths": { "@shared/*": ["src/shared/*"] }
  },
  "include": ["electron.vite.config.ts", "vite.web.config.ts", "build/*.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "tests/**/*", "src/renderer/src/lib/exerciseRig.ts", "vitest.config.ts"]
}
